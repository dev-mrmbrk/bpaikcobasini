rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && 
        request.auth.token.email != null && 
        (request.auth.token.email.lower() == 'ridhwanmujahidin01@gmail.com' ||
         request.auth.token.email.lower() == 'ridhwan.mbrk@gmail.com' ||
         request.auth.token.email.lower() == 'eungeunyoon@gmail.com');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'ADMIN' &&
        getUserData().status == 'aktif'
      );
    }

    // Users: Employees roster (Readable for roster checks, writable by admins or bootstrapping)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Events: Public calendar of BPAIK activities & attendance sessions
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Attendance Records: Attendance list and signatures
    match /attendanceRecords/{recordId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Leave Requests: Permission submissions and approvals
    match /leaveRequests/{requestId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Audit logs: Activity history
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
